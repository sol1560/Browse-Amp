{
  "name": "browse-amp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "tsx apps/server/main.ts",
    "build": "tsc --noEmit && vite build --config apps/console/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "cli": "tsx apps/cli/main.ts",
    "mcp": "tsx apps/mcp/main.ts",
    "init": "tsx scripts/init.ts",
    "console": "vite --config apps/console/vite.config.ts",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "@e2b/desktop": "2.4.0",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/static": "10.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "5.6.2",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
